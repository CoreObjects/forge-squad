# 复制为 server/.env 后填写。不要把真实密钥提交到仓库。

PORT=8787
HOST=0.0.0.0
DB_PATH=server/data/forge.db
# 网页调试版的来源，多个用逗号分隔；* 表示全部
CORS_ORIGINS=*
# 数据看板 /api/admin/report 的访问密钥
ADMIN_KEY=

# ---------- 微信小游戏 ----------
WX_APPID=
WX_APPSECRET=
# 虚拟支付：OfferID / AppKey（沙箱与正式环境的 AppKey 不同）
WX_PAY_OFFER_ID=
WX_PAY_APP_KEY=
# 0 正式环境，1 沙箱环境
WX_PAY_ENV=1
# 消息推送 Token（小游戏后台 → 开发 → 消息推送，URL 填 https://你的域名/api/pay/wx-notify，数据格式 JSON，明文模式）
WX_MSG_TOKEN=
# 虚拟支付后台配置的道具 ID
WX_PRODUCT_FIRST_CHARGE=first_charge
WX_PRODUCT_MONTHLY_CARD=monthly_card

# ---------- 内部测试 ----------
# 设备号登录（网页调试版用），正式环境设为 0
DEV_LOGIN=0
# 开发支付（不走微信，直接到账），正式环境设为 0
DEV_PAY=0
# 竞技场每日次数重置的时区偏移（分钟），北京时间 480
TZ_OFFSET_MINUTES=480
